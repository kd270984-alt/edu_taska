# Скопируйте в .env и заполните своими значениями. .env в репозиторий НЕ попадает.
# Пароли и секреты придумайте сами — например `openssl rand -hex 24` на каждую строку.

# --- адрес приложения ---
# Локально (docker на своей машине): APP_HOST=:80 — Caddy отдаёт по http://localhost:8088
# На сервере: APP_HOST=taska.ваш-домен — Caddy сам получит HTTPS-сертификат.
# Нет своего домена — возьмите бесплатный: IP сервера через дефисы плюс .sslip.io,
# например APP_HOST=89-207-249-162.sslip.io (регистрировать ничего не нужно).
APP_HOST=:80
ACME_EMAIL=you@example.com

# Куда пробрасывать порты Caddy. Локально — только петля, наружу ничего не открываем.
HTTP_BIND=127.0.0.1:8088
HTTPS_BIND=127.0.0.1:8444

# Кому разрешено обращаться к API из браузера с чужого адреса. Обычно НИКОМУ: фронт лежит
# на том же домене, и строку можно оставить пустой. Заполняйте, только если приложение открывают
# с другого адреса (например, отдельный домен для мобильного клиента), через запятую.
APP_ORIGIN=

# --- база ---
POSTGRES_DB=taska
POSTGRES_USER=taska
POSTGRES_PASSWORD=
DATABASE_URL=postgres://taska:ЗДЕСЬ_ТОТ_ЖЕ_ПАРОЛЬ@postgres:5432/taska

# --- файлы ---
MINIO_ROOT_USER=taskaminio
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=attachments

# --- подпись сессий (любая длинная случайная строка) ---
JWT_SECRET=

# --- прочее ---
ADMIN_EMAIL=admin@example.com       # логин первого администратора (пароль система напечатает в журнале)
TRASH_DAYS=30                       # корзина: через сколько дней удалённое стирается насовсем
ARCHIVE_DAYS=365                    # архив: через сколько дней завершённое стирается насовсем

# --- телеграм-агент (необязательно) ---
AGENT_EMAIL=agent@taska.local       # учётка, под которой в Таску ходит агент
AGENT_PASSWORD=                     # её пароль (заведите пользователя в Таске и впишите сюда)
TELEGRAM_BOT_TOKEN=                 # токен бота от @BotFather
OPENAI_API_KEY=                     # ключ модели для агента (OpenAI)
AGENT_MODEL=gpt-5                   # какой моделью думает агент
AGENT_VOICE=on                      # распознавать голосовые в Телеграме (off — выключить)
AGENT_STT_MODEL=gpt-4o-transcribe   # чем распознавать речь
AGENT_DEBUG=0                       # 1 — печатать в журнал бота вызовы инструментов (для отладки)
TASKA_URL=http://caddy              # адрес Таски изнутри docker; менять не нужно

# --- часовой пояс команды: от него считаются «сегодня» и перенос просроченного ---
APP_TZ=Europe/Moscow                # например Asia/Almaty, Asia/Yekaterinburg

NODE_ENV=production
API_PORT=3000
